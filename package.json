{
  "name": "piranha",
  "version": "2.0.4",
  "description": "PiRanha — an autonomous bug-bounty swarm for Pi: 53 specialized security agents and a deterministic engagement router that classify a target and dispatch the right hunters in parallel across web, API, LLM/agentic, mobile, binary/firmware, cloud (AWS/Azure/GCP/k8s), and network/AD.",
  "keywords": [
    "pi-package",
    "security",
    "bug-bounty",
    "pentest",
    "offensive-security",
    "ai-agents",
    "appsec",
    "cloud-security",
    "red-team"
  ],
  "license": "MIT",
  "author": "h4ckologic",
  "bin": {
    "piranha": "./cli/piranha.ts"
  },
  "scripts": {
    "build": "bun build ./cli/piranha.ts --compile --outfile dist/piranha",
    "build:darwin-arm64": "bun build ./cli/piranha.ts --compile --target=bun-darwin-arm64 --outfile dist/piranha-darwin-arm64",
    "build:darwin-x64": "bun build ./cli/piranha.ts --compile --target=bun-darwin-x64 --outfile dist/piranha-darwin-x64",
    "build:linux-x64": "bun build ./cli/piranha.ts --compile --target=bun-linux-x64 --outfile dist/piranha-linux-x64",
    "build:linux-arm64": "bun build ./cli/piranha.ts --compile --target=bun-linux-arm64 --outfile dist/piranha-linux-arm64",
    "build:windows-x64": "bun build ./cli/piranha.ts --compile --target=bun-windows-x64 --outfile dist/piranha-windows-x64.exe",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64"
  },
  "homepage": "https://github.com/djzzlim/PiRanha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djzzlim/PiRanha.git"
  },
  "bugs": {
    "url": "https://github.com/djzzlim/PiRanha/issues"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "cli",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ]
}
